# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Set to "true" to force mock/demo data even when Supabase is configured.
# Remove or set to "false" in production.
VITE_USE_MOCK_DATA=false

# ─── Stripe (add later) ─────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# These are NEVER exposed to the browser — used only in Supabase Edge Functions.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (email notifications) ───────────────────────────────────────────
# Free tier: 3,000 emails/month. Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ─── WhatsApp Business API via Meta Cloud API (FREE tier) ───────────────────
# Free for first 1,000 service conversations/month.
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1. Create a Meta Business account at business.facebook.com
# 2. Add a WhatsApp Business app at developers.facebook.com
# 3. Get your Phone Number ID from the WhatsApp dashboard
# 4. Generate a permanent token from System Users in Meta Business Settings
WHATSAPP_API_TOKEN=your-meta-graph-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ─── Supabase Service Role (Edge Functions only — NEVER expose to browser) ──
# Get from: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
